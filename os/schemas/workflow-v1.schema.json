{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOSFS workflow manifest v1",
  "description": "Manifest contract for a bounded workflow. The guest checks references and dependency cycles, then runs blocks in dependency order. A block's inputs must be available files or outputs of blocks it directly depends on; outputs must end in .OUT.",
  "type": "object",
  "required": [
    "schemaVersion",
    "workflowId",
    "failurePolicy",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "nosfs.workflow.v1"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,47}$"
    },
    "failurePolicy": {
      "enum": [
        "stop",
        "continue"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "blockId",
          "taskManifest",
          "dependsOn",
          "inputFiles",
          "outputFiles"
        ],
        "properties": {
          "blockId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
          },
          "taskManifest": {
            "$ref": "#/$defs/fileName"
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
            }
          },
          "inputFiles": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/fileName"
            }
          },
          "outputFiles": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/fileName"
                },
                {
                  "pattern": "\\.OUT$"
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fileName": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{0,14}$",
      "maxLength": 15
    }
  }
}
