{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rabbitsoftware.local/rabbitsoftware-sync-api-v1.schema.json",
  "title": "RabbitSoftware sync API v1",
  "description": "Between rabbitsoft/sync.py and the sync service (deploy/cloudflare-sync). Signed requests carry X-Account, X-Device (32 hex each), X-Time (milliseconds) and X-Signature: base64 Ed25519 of METHOD\\nPATH\\nTIME\\nSHA256-HEX-OF-BODY by the device key. Public routes: GET /health, GET /v1/corpus/batches, GET /v1/corpus/batches/{name}, GET /v1/pairing/{slot}, POST /v1/devices (signed by the account key in its body). Signed routes: GET/DELETE /v1/devices[/{id}], PUT/GET /v1/history/{name}, GET /v1/history, POST /v1/corpus, POST /v1/training, POST /v1/pairing, GET /v1/admin/training.",
  "$defs": {
    "id32": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
    "registerRequest": {
      "description": "POST /v1/devices. signature: account key over register\\nACCOUNT\\nDEVICE_KEY\\nNAME\\nTIME. New accounts also need the X-Signup-Key header until the launch.",
      "type": "object",
      "required": ["account_key", "device_key", "name", "time", "signature"],
      "properties": {
        "account_key": {"$ref": "#/$defs/base64"},
        "device_key": {"$ref": "#/$defs/base64"},
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "time": {"type": "integer"},
        "signature": {"$ref": "#/$defs/base64"}
      }
    },
    "registerReply": {
      "type": "object",
      "required": ["account", "device"],
      "properties": {"account": {"$ref": "#/$defs/id32"}, "device": {"$ref": "#/$defs/id32"}}
    },
    "devicesReply": {
      "type": "object",
      "required": ["devices"],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["device", "name", "added_at", "removed"],
            "properties": {
              "device": {"$ref": "#/$defs/id32"},
              "name": {"type": "string"},
              "added_at": {"type": "string"},
              "removed": {"type": "boolean"}
            }
          }
        }
      }
    },
    "historyList": {
      "type": "object",
      "required": ["history"],
      "properties": {
        "history": {"type": "array", "items": {"type": "object", "required": ["name", "bytes"],
          "properties": {"name": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}}}}
      }
    },
    "record": {
      "description": "A public research record. source_url must be https.",
      "type": "object",
      "required": ["source", "external_id", "title", "source_url"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 32},
        "external_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "abstract": {"type": "string", "maxLength": 6000},
        "source_url": {"type": "string", "pattern": "^https://", "maxLength": 300},
        "published_at": {"type": "string", "maxLength": 32}
      }
    },
    "corpusUpload": {
      "type": "object",
      "required": ["records"],
      "properties": {"records": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/record"}}}
    },
    "corpusUploadReply": {
      "type": "object",
      "required": ["batch", "records"],
      "properties": {"batch": {"type": "string"}, "records": {"type": "integer", "minimum": 1}}
    },
    "corpusBatchList": {
      "type": "object",
      "required": ["batches"],
      "properties": {"batches": {"type": "array", "items": {"type": "string"}}}
    },
    "corpusBatch": {
      "type": "object",
      "required": ["records"],
      "properties": {"records": {"type": "array", "items": {"$ref": "#/$defs/record"}}}
    },
    "trainingItem": {
      "description": "POST /v1/training: an answer someone chose to share. Stored with no account or device.",
      "type": "object",
      "required": ["question", "answer"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 2000},
        "answer": {"type": "string", "minLength": 1, "maxLength": 4000},
        "sources": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 300}},
        "rating": {"enum": [-1, 0, 1]},
        "model": {"type": "string", "maxLength": 64}
      }
    },
    "pairingCreate": {
      "type": "object",
      "required": ["slot", "sealed"],
      "properties": {"slot": {"type": "string", "pattern": "^[A-Z2-7]{4}$"}, "sealed": {"$ref": "#/$defs/base64", "maxLength": 1024}}
    },
    "pairingCreated": {
      "type": "object",
      "required": ["slot", "expires_in"],
      "properties": {"slot": {"type": "string"}, "expires_in": {"type": "integer"}}
    },
    "pairingSlot": {
      "type": "object",
      "required": ["sealed"],
      "properties": {"sealed": {"$ref": "#/$defs/base64"}}
    },
    "ok": {"type": "object"},
    "error": {
      "description": "401 unsigned, wrong signature or clock off; 403 not part of the account, sign-up closed, or not the owner; 404; 409 slot taken or too many devices; 413 over 1 MB; 429 over a daily limit.",
      "type": "object",
      "required": ["error"],
      "properties": {"error": {"type": "string"}}
    }
  }
}
