{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rabbitsoftware.local/rabbitsoftware-sync-api-v1.schema.json",
  "title": "RabbitSoftware sync API v1",
  "description": "Between rabbitsoft/sync.py and the sync service (deploy/cloudflare-sync). Signed requests carry X-Account, X-Device (32 hex each), X-Time (milliseconds) and X-Signature: base64 Ed25519 of METHOD\\nPATH\\nTIME\\nSHA256-HEX-OF-BODY by the device key. Public routes: GET /health, GET /v1/corpus/batches, GET /v1/corpus/batches/{name}, GET /v1/pairing/{slot}, POST /v1/devices (signed by the account key in its body). Signed routes: GET/DELETE /v1/devices[/{id}], PUT/GET /v1/history/{name}, GET /v1/history, POST /v1/corpus, POST /v1/training, POST /v1/pairing, GET /v1/admin/training.",
  "$defs": {
    "id32": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
    "registerRequest": {
      "description": "POST /v1/devices. signature: account key over register\\nACCOUNT\\nDEVICE_KEY\\nNAME\\nTIME. New accounts also need the X-Signup-Key header until the launch.",
      "type": "object",
      "required": ["account_key", "device_key", "name", "time", "signature"],
      "properties": {
        "account_key": {"$ref": "#/$defs/base64"},
        "device_key": {"$ref": "#/$defs/base64"},
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "time": {"type": "integer"},
        "signature": {"$ref": "#/$defs/base64"}
      }
    },
    "registerReply": {
      "type": "object",
      "required": ["account", "device"],
      "properties": {"account": {"$ref": "#/$defs/id32"}, "device": {"$ref": "#/$defs/id32"}}
    },
    "devicesReply": {
      "type": "object",
      "required": ["devices"],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["device", "name", "added_at", "removed"],
            "properties": {
              "device": {"$ref": "#/$defs/id32"},
              "name": {"type": "string"},
              "added_at": {"type": "string"},
              "removed": {"type": "boolean"}
            }
          }
        }
      }
    },
    "historyList": {
      "type": "object",
      "required": ["history"],
      "properties": {
        "history": {"type": "array", "items": {"type": "object", "required": ["name", "bytes"],
          "properties": {"name": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}}}}
      }
    },
    "record": {
      "description": "A public research record. source_url must be https.",
      "type": "object",
      "required": ["source", "external_id", "title", "source_url"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 32},
        "external_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "abstract": {"type": "string", "maxLength": 6000},
        "source_url": {"type": "string", "pattern": "^https://", "maxLength": 300},
        "published_at": {"type": "string", "maxLength": 32}
      }
    },
    "corpusUpload": {
      "type": "object",
      "required": ["records"],
      "properties": {"records": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/record"}}}
    },
    "corpusUploadReply": {
      "type": "object",
      "required": ["batch", "records"],
      "properties": {
        "batch": {"type": "string"},
        "records": {"type": "integer", "minimum": 1},
        "new_records": {"type": "integer", "minimum": 0, "description": "records not already in the shared corpus (D1)"}
      }
    },
    "recordSummary": {
      "type": "object",
      "required": ["source", "external_id", "title", "source_url", "published_at"],
      "properties": {
        "source": {"type": "string"}, "external_id": {"type": "string"}, "title": {"type": "string"},
        "source_url": {"type": "string"}, "published_at": {"type": "string"}
      }
    },
    "corpusSearchReply": {
      "description": "GET /v1/corpus/search?q=&limit=: shared records whose title or abstract contains every word (D1).",
      "type": "object",
      "required": ["query", "records"],
      "properties": {"query": {"type": "string"}, "records": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/recordSummary"}}}
    },
    "corpusStats": {
      "description": "GET /v1/corpus/stats: shared records per source (D1).",
      "type": "object",
      "required": ["total", "sources"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "sources": {"type": "array", "items": {
          "type": "object",
          "required": ["source", "records"],
          "properties": {"source": {"type": "string"}, "records": {"type": "integer"}, "last_added": {"type": ["string", "null"]}}
        }}
      }
    },
    "reviewStatus": {"enum": ["pending", "approved", "rejected"]},
    "trainingAnswer": {
      "description": "A shared answer as the owner sees it (D1 training_answers). No account or device.",
      "type": "object",
      "required": ["id", "shared_at", "question", "answer", "sources", "rating", "model", "status"],
      "properties": {
        "id": {"type": "string"}, "shared_at": {"type": "string"},
        "question": {"type": "string"}, "answer": {"type": "string"},
        "sources": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
        "rating": {"enum": [-1, 0, 1]}, "model": {"type": "string"}, "status": {"$ref": "#/$defs/reviewStatus"},
        "reviewed_at": {"type": ["string", "null"]}, "exported_in": {"type": ["string", "null"]}
      }
    },
    "trainingList": {
      "description": "GET /v1/admin/training?status= and GET /v1/admin/training/export (owner only).",
      "type": "object",
      "required": ["items"],
      "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/trainingAnswer"}}}
    },
    "trainingReview": {
      "description": "POST /v1/admin/training/review (owner only).",
      "type": "object",
      "required": ["ids", "status"],
      "properties": {"ids": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"type": "string"}}, "status": {"$ref": "#/$defs/reviewStatus"}}
    },
    "trainingReviewReply": {
      "type": "object",
      "required": ["updated"],
      "properties": {"updated": {"type": "integer", "minimum": 0}}
    },
    "trainingExported": {
      "description": "POST /v1/admin/training/exported (owner only), once the export file is on Hugging Face.",
      "type": "object",
      "required": ["file", "sha256", "ids"],
      "properties": {
        "file": {"type": "string", "pattern": "^data/[0-9A-Za-z._-]{1,80}\\.parquet$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hf_commit": {"type": "string"},
        "ids": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"type": "string"}}
      }
    },
    "trainingExportedReply": {
      "type": "object",
      "required": ["file", "marked"],
      "properties": {"file": {"type": "string"}, "marked": {"type": "integer", "minimum": 0}}
    },
    "adminStats": {
      "description": "GET /v1/admin/stats (owner only).",
      "type": "object",
      "required": ["accounts", "training", "corpus", "exports"],
      "properties": {
        "accounts": {"type": "integer", "minimum": 0},
        "training": {"type": "array", "items": {
          "type": "object",
          "required": ["status", "answers"],
          "properties": {"status": {"$ref": "#/$defs/reviewStatus"}, "answers": {"type": "integer"}, "exported": {"type": ["integer", "null"]}}
        }},
        "corpus": {"type": "object", "required": ["records", "sources"]},
        "exports": {"type": "object", "required": ["files", "rows"]}
      }
    },
    "corpusBatchList": {
      "type": "object",
      "required": ["batches"],
      "properties": {"batches": {"type": "array", "items": {"type": "string"}}}
    },
    "corpusBatch": {
      "type": "object",
      "required": ["records"],
      "properties": {"records": {"type": "array", "items": {"$ref": "#/$defs/record"}}}
    },
    "trainingItem": {
      "description": "POST /v1/training: an answer someone chose to share. Stored with no account or device.",
      "type": "object",
      "required": ["question", "answer"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 2000},
        "answer": {"type": "string", "minLength": 1, "maxLength": 4000},
        "sources": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 300}},
        "rating": {"enum": [-1, 0, 1]},
        "model": {"type": "string", "maxLength": 64}
      }
    },
    "pairingCreate": {
      "type": "object",
      "required": ["slot", "sealed"],
      "properties": {"slot": {"type": "string", "pattern": "^[A-Z2-7]{4}$"}, "sealed": {"$ref": "#/$defs/base64", "maxLength": 1024}}
    },
    "pairingCreated": {
      "type": "object",
      "required": ["slot", "expires_in"],
      "properties": {"slot": {"type": "string"}, "expires_in": {"type": "integer"}}
    },
    "pairingSlot": {
      "type": "object",
      "required": ["sealed"],
      "properties": {"sealed": {"$ref": "#/$defs/base64"}}
    },
    "ok": {"type": "object"},
    "error": {
      "description": "401 unsigned, wrong signature or clock off; 403 not part of the account, sign-up closed, or not the owner; 404; 409 slot taken or too many devices; 413 over 1 MB; 429 over a daily limit.",
      "type": "object",
      "required": ["error"],
      "properties": {"error": {"type": "string"}}
    }
  }
}
