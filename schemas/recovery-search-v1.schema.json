{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-os.local/schemas/recovery-search-v1.schema.json",
  "title": "Network OS recovery search configuration",
  "description": "Disabled-by-default policy for future read-only, identity-based recovery searches. This schema does not connect to peers or authorize uploads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enabled",
    "identities",
    "sources",
    "endpointIds",
    "maxResults",
    "includePrivateContent"
  ],
  "properties": {
    "schemaVersion": {
      "const": "network-os.recovery-search.v1"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identityId",
          "mode",
          "publicKeyHex",
          "keyRef"
        ],
        "properties": {
          "identityId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "user-recovery-key",
              "pinned-node-key"
            ]
          },
          "publicKeyHex": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "keyRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Reference to a protected local key store; never a private-key value."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "configured-peer-index",
          "project-chain-index"
        ]
      }
    },
    "endpointIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 100
    },
    "includePrivateContent": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 1
          },
          "endpointIds": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
